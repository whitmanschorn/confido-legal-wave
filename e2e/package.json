{
  "name": "legal-wave-e2e",
  "private": true,
  "version": "1.0.0",
  "description": "Credential-free Playwright suite for Legal Wave, backed by a local mock of the Confido GraphQL API.",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "mock": "tsx mock-server/server.ts",
    "refresh-schema": "tsx mock-server/scripts/refresh-schema.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@graphql-tools/mock": "^9.0.0",
    "@graphql-tools/schema": "^10.0.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "graphql": "16.8.1",
    "graphql-yoga": "^5.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
